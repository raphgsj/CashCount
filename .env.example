# Shared runtime mode: development, test, or production.
NODE_ENV=

# Backend defaults and observability.
APP_TIMEZONE=
DEFAULT_CURRENCY=
LOG_LEVEL=
SENTRY_DSN=

# PostgreSQL. LOCAL_DATABASE_URL is accepted only outside production.
DATABASE_URL=
LOCAL_DATABASE_URL=

# Pluggy worker credentials and API endpoint.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=

# Pluggy-to-API webhook credential; use independently generated Base64, Base64url, or hex.
PLUGGY_WEBHOOK_SECRET=

# Versioned data-encryption keyring. Each value must be canonical Base64 for exactly 32 bytes.
DATA_ENCRYPTION_ACTIVE_KEY_VERSION=
DATA_ENCRYPTION_KEYRING_JSON=

# API trust-boundary credentials; generate each independently with at least 32 random bytes.
API_WORKSPACE_ID=
WEB_TO_API_TOKEN=
MCP_TO_API_READONLY_TOKEN=

# API and web service locations.
WEB_APP_URL=
API_PUBLIC_URL=
API_PRIVATE_URL=

# Web authentication. AUTH_SECRET and WEB_TO_API_TOKEN remain server-only.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_USER_EMAIL=
FINANCE_API_BASE_URL=
NEXT_PUBLIC_APP_NAME=

# Local web convenience; production rejects true.
ALLOW_DEV_AUTH_BYPASS=

# MCP endpoints, client credential, and request limit.
MCP_PUBLIC_URL=
FINANCE_API_PRIVATE_URL=
MCP_CLIENT_TO_MCP_TOKEN=
MCP_RATE_LIMIT_PER_MINUTE=
