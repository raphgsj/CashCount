{
  "name": "@cashcount/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cashcount/config": "workspace:*",
    "@cashcount/db": "workspace:*",
    "@cashcount/provider-core": "workspace:*",
    "@cashcount/provider-pluggy": "workspace:*"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src/config.test.ts src/discover-connections.test.ts src/account-import.test.ts src/transaction-import.test.ts",
    "sync:discover": "tsx src/discover-cli.ts"
  }
}
